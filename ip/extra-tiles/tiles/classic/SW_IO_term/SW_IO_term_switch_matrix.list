# SW_IO_term

# IOBUF to any GBUF
GBUF_A_[IN|IN|IN|IN],S_GBUF_FEED_END[0|1|2|3]
GBUF_B_[IN|IN|IN|IN],S_GBUF_FEED_END[0|1|2|3]
GBUF_C_[IN|IN|IN|IN],S_GBUF_FEED_END[0|1|2|3]
GBUF_D_[IN|IN|IN|IN],S_GBUF_FEED_END[0|1|2|3]

GBUF_A_[IN|IN|IN|IN],W_GBUF_FEED_END[0|1|2|3]
GBUF_B_[IN|IN|IN|IN],W_GBUF_FEED_END[0|1|2|3]
GBUF_C_[IN|IN|IN|IN],W_GBUF_FEED_END[0|1|2|3]
GBUF_D_[IN|IN|IN|IN],W_GBUF_FEED_END[0|1|2|3]

GBUF_A_[IN],SYS_RESET_RESET
GBUF_B_[IN],SYS_RESET_RESET
GBUF_C_[IN],SYS_RESET_RESET
GBUF_D_[IN],SYS_RESET_RESET

GBUF_A_[IN],IOBUF_OUT
GBUF_B_[IN],IOBUF_OUT
GBUF_C_[IN],IOBUF_OUT
GBUF_D_[IN],IOBUF_OUT

# GBUF to north and east
N_GBUF_BEG[0|1|2|3],[GBUF_A_OUT|GBUF_B_OUT|GBUF_C_OUT|GBUF_D_OUT]
E_GBUF_BEG[0|1|2|3],[GBUF_A_OUT|GBUF_B_OUT|GBUF_C_OUT|GBUF_D_OUT]

# IOBUF is only used as input
# (why not use an IBUF then? because it will be mapped to an IOBUF)

# IOBUF clock
IOBUF_[CLK|CLK],[GND0|VCC0]

# Fabric to PAD output multiplexers
IOBUF_[IN|IN],[GND0|VCC0]

# Tristate control for those PADs
IOBUF_[EN|EN],[GND0|VCC0]
